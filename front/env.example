# ZetaFlow 环境配置示例
# 复制此文件为 .env 并填入实际值

# WalletConnect Project ID (从 https://cloud.walletconnect.com/ 获取)
VITE_WALLET_CONNECT_PROJECT_ID=your-project-id-here

# RPC 节点配置 (可选，使用公共节点或自定义节点)
VITE_ZETACHAIN_ATHENS_RPC=https://zetachain-athens-evm.blockpi.network/v1/rpc/public
VITE_SEPOLIA_RPC=https://rpc.sepolia.org
VITE_BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# 合约地址 (部署后更新)
VITE_UNIVERSAL_APP_ADDRESS=0x0000000000000000000000000000000000000000

# 应用配置
VITE_APP_NAME=ZetaFlow
VITE_APP_URL=https://zetaflow.app
VITE_APP_DESCRIPTION=AI 驱动的跨链资产配置器

# 开发模式配置
VITE_ENABLE_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# API 配置 (如果需要后端 API)
VITE_API_BASE_URL=https://api.zetaflow.app
VITE_API_TIMEOUT=30000



